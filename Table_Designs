CREATE DATABASE Music_Library;

CREATE TABLE songs (
song_ID int AUTO_INCREMENT PK,
song_name varchar(150) NOT NULL,
bpm int NULL,
album_id int NOT NULL FK,
genre_id int NOT NULL FK
);

CREATE TABLE albums (
album_id int AUTO_INCREMENT PK,
album_name varchar(150) NOT NULL,
artist_id int FK NOT NULL,
release_year int NOT NULL,
);

CREATE TABLE artists (
artist_id int AUTO_INCREMENT PK,
name varchar(50) NOT NULL,
);

CREATE TABLE genre (
genre_id int AUTO_INCREMENT PK,
name varchar(50) NOT NULL
);


Relationships
albums to songs (1:M): One album can contain many songs. A song belongs to one album.
genres to songs (1:M): One genre can be assigned to many songs. A song belongs to one genre.
artists to albums (1:M): One artist can have many albums. An album belongs to one artist.
